    {
      "id": "mod-clock-driven-dff",
      "name": "Clock-driven D Flip-Flop",
      "description": "Clock node je pripojeny na CLK vstup D Flip-Flopu, Button je pripojeny na D vstup. Overuje interakciu clock a button nodu s D-FF. Ked clock=0→1 (rising edge), DFF ulozi aktualnu hodnotu button-u. Toto je zakladny stavebny blok registrov — data sa ulozia LEN pri clock edge.",
      "inputs": [],
      "outputs": [
        { "id": "q", "name": "Q", "direction": "output", "bits": 1 }
      ],
      "circuit": {
        "id": "cdff-circuit", "name": "Clock-driven D Flip-Flop",
        "nodes": [
          { "id": "clk", "type": "clock", "position": { "x": 0, "y": 150 }, "rotation": 0, "pins": [{ "id": "cp", "name": "CLK", "direction": "output", "bits": 1 }] },
          { "id": "btn", "type": "button", "position": { "x": 0, "y": 0 }, "rotation": 0, "pins": [{ "id": "bp", "name": "DATA", "direction": "output", "bits": 1 }] },
          { "id": "dff", "type": "module", "moduleId": "mod-d-flipflop", "position": { "x": 250, "y": 0 }, "rotation": 0, "pins": [
            { "id": "dd", "name": "D", "direction": "input", "bits": 1 },
            { "id": "dc", "name": "CLK", "direction": "input", "bits": 1 },
            { "id": "dq", "name": "Q", "direction": "output", "bits": 1 }
          ]},
          { "id": "qo", "type": "output", "position": { "x": 500, "y": 0 }, "rotation": 0, "pins": [{ "id": "q", "name": "Q", "direction": "input", "bits": 1 }] }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "btn", "fromPinId": "bp", "toNodeId": "dff", "toPinId": "dd" },
          { "id": "e2", "fromNodeId": "clk", "fromPinId": "cp", "toNodeId": "dff", "toPinId": "dc" },
          { "id": "e3", "fromNodeId": "dff", "fromPinId": "dq", "toNodeId": "qo", "toPinId": "q" }
        ]
      },
      "createdAt": "2026-02-16T00:00:00.000Z",
      "updatedAt": "2026-02-16T00:00:00.000Z"
    },
    {
      "id": "mod-button-sr-control",
      "name": "Button SR Control",
      "description": "Dva buttony — SET a RESET — ovladaju SR Latch. Button SET pulse nastavi Q=1, button RESET pulse nastavi Q=0. Ked ani jeden nie je stlaceny (oba=1 pre NAND SR), latch drzi poslednu hodnotu. NEMA sa stat, ze oba buttony su stlacene sucasne (S=0, R=0 pre NAND SR je zakazany stav).",
      "inputs": [],
      "outputs": [
        { "id": "q", "name": "Q", "direction": "output", "bits": 1 },
        { "id": "qbar", "name": "Q\u0304", "direction": "output", "bits": 1 }
      ],
      "circuit": {
        "id": "bsrc-circuit", "name": "Button SR Control",
        "nodes": [
          { "id": "btn_s", "type": "button", "position": { "x": 0, "y": 50 }, "rotation": 0, "pins": [{ "id": "bs", "name": "SET", "direction": "output", "bits": 1 }] },
          { "id": "btn_r", "type": "button", "position": { "x": 0, "y": 200 }, "rotation": 0, "pins": [{ "id": "br", "name": "RST", "direction": "output", "bits": 1 }] },
          { "id": "sr", "type": "module", "moduleId": "mod-sr-latch", "position": { "x": 250, "y": 100 }, "rotation": 0, "pins": [
            { "id": "ss", "name": "S", "direction": "input", "bits": 1 },
            { "id": "sr", "name": "R", "direction": "input", "bits": 1 },
            { "id": "sq", "name": "Q", "direction": "output", "bits": 1 },
            { "id": "sqb", "name": "Q\u0304", "direction": "output", "bits": 1 }
          ]},
          { "id": "qo", "type": "output", "position": { "x": 500, "y": 50 }, "rotation": 0, "pins": [{ "id": "q", "name": "Q", "direction": "input", "bits": 1 }] },
          { "id": "qbo", "type": "output", "position": { "x": 500, "y": 200 }, "rotation": 0, "pins": [{ "id": "qbar", "name": "Q\u0304", "direction": "input", "bits": 1 }] }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "btn_s", "fromPinId": "bs", "toNodeId": "sr", "toPinId": "ss" },
          { "id": "e2", "fromNodeId": "btn_r", "fromPinId": "br", "toNodeId": "sr", "toPinId": "sr" },
          { "id": "e3", "fromNodeId": "sr", "fromPinId": "sq", "toNodeId": "qo", "toPinId": "q" },
          { "id": "e4", "fromNodeId": "sr", "fromPinId": "sqb", "toNodeId": "qbo", "toPinId": "qbar" }
        ]
      },
      "createdAt": "2026-02-16T00:00:00.000Z",
      "updatedAt": "2026-02-16T00:00:00.000Z"
    },
    {
      "id": "mod-clock-and-button-enable",
      "name": "Clock + Button Enable",
      "description": "Clock je AND-ovany s Button — vysledok ide na CLK vstup D Flip-Flopu. Toto vytvara 'gated clock': DFF sa aktualizuje LEN ked je button stlaceny A zaroven pride clock edge. Ak button nie je stlaceny, clock signal neprejde a DFF drzi staru hodnotu. Testuje AND(Clock, Button) → DFF pattern.",
      "inputs": [
        { "id": "d", "name": "D", "direction": "input", "bits": 1 }
      ],
      "outputs": [
        { "id": "q", "name": "Q", "direction": "output", "bits": 1 }
      ],
      "circuit": {
        "id": "cbe-circuit", "name": "Clock + Button Enable",
        "nodes": [
          { "id": "di", "type": "input", "position": { "x": 0, "y": 0 }, "rotation": 0, "pins": [{ "id": "d", "name": "D", "direction": "output", "bits": 1 }] },
          { "id": "clk", "type": "clock", "position": { "x": 0, "y": 100 }, "rotation": 0, "pins": [{ "id": "cp", "name": "CLK", "direction": "output", "bits": 1 }] },
          { "id": "btn", "type": "button", "position": { "x": 0, "y": 200 }, "rotation": 0, "pins": [{ "id": "bp", "name": "EN", "direction": "output", "bits": 1 }] },
          { "id": "gate_nand1", "type": "module", "moduleId": "builtin:nand", "position": { "x": 200, "y": 150 }, "rotation": 0, "pins": [
            { "id": "ga", "name": "A", "direction": "input", "bits": 1 },
            { "id": "gb", "name": "B", "direction": "input", "bits": 1 },
            { "id": "go", "name": "Out", "direction": "output", "bits": 1 }
          ]},
          { "id": "gate_nand2", "type": "module", "moduleId": "builtin:nand", "position": { "x": 350, "y": 150 }, "rotation": 0, "pins": [
            { "id": "ga2", "name": "A", "direction": "input", "bits": 1 },
            { "id": "gb2", "name": "B", "direction": "input", "bits": 1 },
            { "id": "go2", "name": "Out", "direction": "output", "bits": 1 }
          ]},
          { "id": "dff", "type": "module", "moduleId": "mod-d-flipflop", "position": { "x": 500, "y": 0 }, "rotation": 0, "pins": [
            { "id": "dd", "name": "D", "direction": "input", "bits": 1 },
            { "id": "dc", "name": "CLK", "direction": "input", "bits": 1 },
            { "id": "dq", "name": "Q", "direction": "output", "bits": 1 }
          ]},
          { "id": "qo", "type": "output", "position": { "x": 700, "y": 0 }, "rotation": 0, "pins": [{ "id": "q", "name": "Q", "direction": "input", "bits": 1 }] }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "clk", "fromPinId": "cp", "toNodeId": "gate_nand1", "toPinId": "ga" },
          { "id": "e2", "fromNodeId": "btn", "fromPinId": "bp", "toNodeId": "gate_nand1", "toPinId": "gb" },
          { "id": "e3", "fromNodeId": "gate_nand1", "fromPinId": "go", "toNodeId": "gate_nand2", "toPinId": "ga2" },
          { "id": "e4", "fromNodeId": "gate_nand1", "fromPinId": "go", "toNodeId": "gate_nand2", "toPinId": "gb2" },
          { "id": "e5", "fromNodeId": "di", "fromPinId": "d", "toNodeId": "dff", "toPinId": "dd" },
          { "id": "e6", "fromNodeId": "gate_nand2", "fromPinId": "go2", "toNodeId": "dff", "toPinId": "dc" },
          { "id": "e7", "fromNodeId": "dff", "fromPinId": "dq", "toNodeId": "qo", "toPinId": "q" }
        ]
      },
      "createdAt": "2026-02-16T00:00:00.000Z",
      "updatedAt": "2026-02-16T00:00:00.000Z"
    },
    {
      "id": "mod-button-toggle",
      "name": "Button Toggle (D Latch)",
      "description": "Button ovlada enable D Latch-u, input je fixne na 1 (VCC). Ked je button stlaceny (EN=1), latch sa transparentne otvori a Q=D=1. Ked sa button pusti (EN=0), latch drzi poslednu hodnotu. Testuje button ako enable signal pre level-sensitive latch. POZOR: toto NIE JE toggle v zmysle flip-flopu — je to latch hold behavior.",
      "inputs": [],
      "outputs": [
        { "id": "q", "name": "Q", "direction": "output", "bits": 1 }
      ],
      "circuit": {
        "id": "btog-circuit", "name": "Button Toggle (D Latch)",
        "nodes": [
          { "id": "vcc", "type": "constant", "position": { "x": 0, "y": 0 }, "rotation": 0, "pins": [{ "id": "cv", "name": "1", "direction": "output", "bits": 1 }] },
          { "id": "btn", "type": "button", "position": { "x": 0, "y": 100 }, "rotation": 0, "pins": [{ "id": "bp", "name": "BTN", "direction": "output", "bits": 1 }] },
          { "id": "dl", "type": "module", "moduleId": "mod-d-latch", "position": { "x": 250, "y": 0 }, "rotation": 0, "pins": [
            { "id": "dld", "name": "D", "direction": "input", "bits": 1 },
            { "id": "dle", "name": "EN", "direction": "input", "bits": 1 },
            { "id": "dlq", "name": "Q", "direction": "output", "bits": 1 }
          ]},
          { "id": "qo", "type": "output", "position": { "x": 500, "y": 0 }, "rotation": 0, "pins": [{ "id": "q", "name": "Q", "direction": "input", "bits": 1 }] }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "vcc", "fromPinId": "cv", "toNodeId": "dl", "toPinId": "dld" },
          { "id": "e2", "fromNodeId": "btn", "fromPinId": "bp", "toNodeId": "dl", "toPinId": "dle" },
          { "id": "e3", "fromNodeId": "dl", "fromPinId": "dlq", "toNodeId": "qo", "toPinId": "q" }
        ]
      },
      "createdAt": "2026-02-16T00:00:00.000Z",
      "updatedAt": "2026-02-16T00:00:00.000Z"
    }
  ],
  "library": [
    { "type": "module", "moduleId": "mod-not" },

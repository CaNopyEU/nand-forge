            { "id": "m2", "name": "2", "direction": "input", "bits": 1 },
            { "id": "m3", "name": "3", "direction": "input", "bits": 1 },
            { "id": "mo", "name": "Out", "direction": "output", "bits": 4 }
          ]},
          { "id": "qo", "type": "output", "position": { "x": 700, "y": 0 }, "rotation": 0, "pins": [{ "id": "q", "name": "Q", "direction": "input", "bits": 4 }] }
        ],
        "edges": [
          { "id": "e_in", "fromNodeId": "di", "fromPinId": "d", "toNodeId": "spl", "toPinId": "si" },

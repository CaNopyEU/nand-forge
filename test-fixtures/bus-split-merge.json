{
  "version": 2,
  "modules": [
    {
      "id": "mod-split-merge-roundtrip-8",
      "name": "Split-Merge Roundtrip 8-bit",
      "description": "8-bitovy signal sa rozlozi splitterom na 8 jednotlivych bitov a potom sa znova zlozi mergerom. Vysledok MUSI byt identicky s povodnym vstupom. Testuje, ze splitter/merger zachovava bit ordering (LSB=bit0, MSB=bit7).",
      "inputs": [
        { "id": "d", "name": "D", "direction": "input", "bits": 8 }
      ],
      "outputs": [
        { "id": "q", "name": "Q", "direction": "output", "bits": 8 }
      ],
      "circuit": {
        "id": "smr8-circuit", "name": "Split-Merge Roundtrip 8-bit",
        "nodes": [
          { "id": "di", "type": "input", "position": { "x": 0, "y": 0 }, "rotation": 0, "pins": [{ "id": "d", "name": "D", "direction": "output", "bits": 8 }] },
          { "id": "spl", "type": "module", "moduleId": "builtin:splitter", "position": { "x": 200, "y": 0 }, "rotation": 0, "pins": [
            { "id": "si", "name": "In", "direction": "input", "bits": 8 },
            { "id": "s0", "name": "0", "direction": "output", "bits": 1 },
            { "id": "s1", "name": "1", "direction": "output", "bits": 1 },
            { "id": "s2", "name": "2", "direction": "output", "bits": 1 },
            { "id": "s3", "name": "3", "direction": "output", "bits": 1 },
            { "id": "s4", "name": "4", "direction": "output", "bits": 1 },
            { "id": "s5", "name": "5", "direction": "output", "bits": 1 },
            { "id": "s6", "name": "6", "direction": "output", "bits": 1 },
            { "id": "s7", "name": "7", "direction": "output", "bits": 1 }
          ]},
          { "id": "mrg", "type": "module", "moduleId": "builtin:merger", "position": { "x": 500, "y": 0 }, "rotation": 0, "pins": [
            { "id": "m0", "name": "0", "direction": "input", "bits": 1 },
            { "id": "m1", "name": "1", "direction": "input", "bits": 1 },
            { "id": "m2", "name": "2", "direction": "input", "bits": 1 },
            { "id": "m3", "name": "3", "direction": "input", "bits": 1 },
            { "id": "m4", "name": "4", "direction": "input", "bits": 1 },
            { "id": "m5", "name": "5", "direction": "input", "bits": 1 },
            { "id": "m6", "name": "6", "direction": "input", "bits": 1 },
            { "id": "m7", "name": "7", "direction": "input", "bits": 1 },
            { "id": "mo", "name": "Out", "direction": "output", "bits": 8 }
          ]},
          { "id": "qo", "type": "output", "position": { "x": 700, "y": 0 }, "rotation": 0, "pins": [{ "id": "q", "name": "Q", "direction": "input", "bits": 8 }] }
        ],
        "edges": [
          { "id": "e_in", "fromNodeId": "di", "fromPinId": "d", "toNodeId": "spl", "toPinId": "si" },
          { "id": "e0", "fromNodeId": "spl", "fromPinId": "s0", "toNodeId": "mrg", "toPinId": "m0" },
          { "id": "e1", "fromNodeId": "spl", "fromPinId": "s1", "toNodeId": "mrg", "toPinId": "m1" },
          { "id": "e2", "fromNodeId": "spl", "fromPinId": "s2", "toNodeId": "mrg", "toPinId": "m2" },
          { "id": "e3", "fromNodeId": "spl", "fromPinId": "s3", "toNodeId": "mrg", "toPinId": "m3" },
          { "id": "e4", "fromNodeId": "spl", "fromPinId": "s4", "toNodeId": "mrg", "toPinId": "m4" },
          { "id": "e5", "fromNodeId": "spl", "fromPinId": "s5", "toNodeId": "mrg", "toPinId": "m5" },
          { "id": "e6", "fromNodeId": "spl", "fromPinId": "s6", "toNodeId": "mrg", "toPinId": "m6" },
          { "id": "e7", "fromNodeId": "spl", "fromPinId": "s7", "toNodeId": "mrg", "toPinId": "m7" },
          { "id": "e_out", "fromNodeId": "mrg", "fromPinId": "mo", "toNodeId": "qo", "toPinId": "q" }
        ]
      },
      "createdAt": "2026-02-16T00:00:00.000Z",
      "updatedAt": "2026-02-16T00:00:00.000Z"
